{
  "name": "ai-coding-interviews",
  "version": "1.0.0",
  "private": true,
  "description": "Production-grade AI-assisted engineering interview framework, 30 real-world GitHub cases, and evaluation rubrics.",
  "type": "module",
  "scripts": {
    "fmt": "bun fmt --no-script",
    "fmt:check": "bun fmt --no-script --check",
    "check": "bun check --no-script",
    "test": "bun test",
    "wiki:dry-run": "./scripts/publish-wiki.sh --dry-run",
    "check:repos": "bun run scripts/check-external-repos.ts",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.0",
    "@commitlint/config-conventional": "^19.8.0",
    "@types/bun": "latest",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.0"
  }
}
